# WhatsApp QR Code provider. wwebjs (whatsapp-web.js) is the one this system is built and tested
# for: it supports "digitando…", reactions, group control and reconnection with backoff.
# zapo is experimental and lacks those features.
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
# Log level for the zapo provider (trace, debug, info, warn, error)
ZAPO_LOG_LEVEL=error
# SQLite file where the zapo provider keeps WhatsApp session state
ZAPO_AUTH_PATH=.zapo_auth/state.sqlite

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database: PostgreSQL (local) or Supabase.
# Supabase: Project Settings > Database > Connection string. Use the DIRECT connection
# (port 5432) or the SESSION pooler. Do NOT use the transaction pooler (6543): the
# single-instance lock for WhatsApp sessions needs a session-level connection.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whaticket
DB_USER=postgres
DB_PASS=
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# DB_SSL=true
# DB_POOL_MAX=10

# Company timezone (Rondônia = America/Porto_Velho). Can be changed in Settings.
APP_TIMEZONE=America/Porto_Velho

# Only the instance holding a database lock opens WhatsApp sessions (see docs).
# SINGLE_INSTANCE_LOCK=true

# JWT secrets: two long random values (openssl rand -hex 32). Required in production; without them
# a random secret is made at each start (sessions end when the server restarts).
JWT_SECRET=
JWT_REFRESH_SECRET=

# Behind a reverse proxy (Caddy, Vercel, Nginx) set the number of proxies so the rate limits use the real IP
# TRUST_PROXY=1

# Backend URL
BACKEND_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Proxy
PROXY_PORT=8080
