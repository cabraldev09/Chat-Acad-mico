# Copie para .backup.env no servidor e aplique chmod 600 .backup.env.
# Use um bucket FORA da VPS, dedicado aos backups, e guarde a senha em local seguro.
RESTIC_REPOSITORY=s3:https://s3.exemplo.com/bucket/chat-academico
RESTIC_PASSWORD=troque-por-uma-senha-longa-exclusiva
AWS_ACCESS_KEY_ID=configure-no-servidor
AWS_SECRET_ACCESS_KEY=configure-no-servidor
# AWS_DEFAULT_REGION=us-east-1
