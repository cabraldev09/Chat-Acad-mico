# Copiado para .env pelo install.sh (que pergunta cada valor). Não envie o .env ao GitHub.
API_DOMAIN=api.exemplo.com
BACKEND_URL=https://api.exemplo.com
PUBLIC_URL=https://api.exemplo.com
FRONTEND_URL=https://seu-app.vercel.app

DB_DIALECT=postgres
# Supabase: Connect → Session pooler (porta 5432)
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DB_SSL=true

JWT_SECRET=troque
JWT_REFRESH_SECRET=troque
TRUST_PROXY=1
APP_TIMEZONE=America/Porto_Velho
NODE_ENV=production

ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque
ADMIN_NAME=Administrador

UPLOAD_DIR=/data/public
WWEBJS_AUTH_PATH=/data/wwebjs
ZAPO_AUTH_PATH=/data/zapo/state.sqlite

# quantos números por QR Code o servidor aceita (cerca de 500 MB cada um)
WHATSAPP_MAX_QR=10
